<UserControl
    x:Class="FluentFold.Views.WhatsNewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Background="{ThemeResource CardBackgroundFillColorSecondary}"
            CornerRadius="{ThemeResource ControlCornerRadius}" Padding="16,4">
        <StackPanel Spacing="10">
            <TextBlock Text="Organizer" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemAccentColor}" Margin="0,6,0,0" />

            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="20">
                <Run Text="&#xE73E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />  Redesigned the Organizer screen with a new hero layout, stat cards, and empty states.
            </TextBlock>
            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="20">
                <Run Text="&#xE73E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />  Teaching tips for first-time users, optional in Settings.
            </TextBlock>
            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="20">
                <Run Text="&#xE73E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />  Folder picker now uses a stable window handle so the picker opens every time.
            </TextBlock>

            <TextBlock Text="Analyzer" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemAccentColor}" Margin="0,6,0,0" />
            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="20">
                <Run Text="&#xE73E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />  Progress is now real — no more fake percentage — with elapsed and estimated time remaining.
            </TextBlock>
            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="20">
                <Run Text="&#xE73E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />  Results split into independent cards for Temporary, Cache, and Duplicate files.
            </TextBlock>
            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="20">
                <Run Text="&#xE73E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />  Select All available in every category card; scanning no longer freezes the app.
            </TextBlock>

            <TextBlock Text="General" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemAccentColor}" Margin="0,6,0,0" />
            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="20">
                <Run Text="&#xE73E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />  Fluent design pass with light/dark/high-contrast tokens and accent contrast.
            </TextBlock>
            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="20">
                <Run Text="&#xE73E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />  Accessibility improvements: automation names and IDs on all interactive controls.
            </TextBlock>
            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="20">
                <Run Text="&#xE73E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />  Brand-new app logo across the store listing, Start menu, and splash screen.
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>