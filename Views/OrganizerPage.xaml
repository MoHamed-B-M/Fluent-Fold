<Page
    x:Class="FluentFold.Views.OrganizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FluentFold.Models"
    mc:Ignorable="d">

    <Grid Padding="24">
        <ScrollViewer>
            <StackPanel Spacing="20">

                <!-- Cleanup Suggestion -->
                <InfoBar
                    x:Name="CleanupSuggestionBar"
                    x:Load="{x:Bind ViewModel.ShowCleanupSuggestion, Mode=OneWay}"
                    IsOpen="True" Severity="Warning" IsClosable="True"
                    Message="{x:Bind ViewModel.CleanupSuggestionMessage, Mode=OneWay}"
                    CloseButtonCommand="{x:Bind ViewModel.DismissCleanupSuggestionCommand}">
                    <InfoBar.ActionButton>
                        <Button Content="&#xE74D;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="16" Click="OnCleanupActionClick"
                                AutomationProperties.Name="Review and delete"
                                ToolTipService.ToolTip="Review &amp; Delete" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- Shared InfoBar -->
                <InfoBar
                    IsOpen="{x:Bind ViewModel.IsInfoBarOpen, Mode=TwoWay}"
                    Message="{x:Bind ViewModel.InfoBarMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.InfoBarSeverity, Mode=OneWay}"
                    IsClosable="True" />

                <!-- ====== STANDARD MODE ====== -->
                <StackPanel x:Name="StandardLayout" Visibility="{x:Bind ViewModel.StandardVisibility, Mode=OneWay}" Spacing="20">

                    <Border Style="{StaticResource HeroCardStyle}">
                        <StackPanel Spacing="20" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8B7;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                       FontSize="56" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource SystemAccentColor}" />
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <TextBlock Text="FluentFold" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
                                <TextBlock Text="Organize your files in seconds" Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="StandardSelectFolderButton" Command="{x:Bind ViewModel.PickFolderCommand}" HorizontalAlignment="Center"
                                    PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited"
                                    PointerPressed="Button_PointerPressed" PointerReleased="Button_PointerReleased"
                                    ToolTipService.ToolTip="Select a folder"
                                    AutomationProperties.AutomationId="StandardSelectFolderButton"
                                    AutomationProperties.Name="Select a folder"
                                    Background="{ThemeResource SystemAccentColor}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    BorderThickness="0" CornerRadius="{ThemeResource ControlCornerRadiusLarge}" Padding="20,12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE838;" FontSize="18" />
                                    <TextBlock Text="Select Folder" VerticalAlignment="Center" FontSize="14" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{x:Bind ViewModel.SelectedFolderPath, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.FolderSelectedVisibility, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" FontSize="13" />
                            <StackPanel x:Name="FolderSelectedState" Visibility="{x:Bind ViewModel.FolderSelectedVisibility, Mode=OneWay}"
                                        HorizontalAlignment="Stretch">
<Button x:Name="HeroOrganizeButton"
                                    Command="{x:Bind ViewModel.OrganizeCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanOrganize, Mode=OneWay}"
                                    PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited"
                                    PointerPressed="Button_PointerPressed" PointerReleased="Button_PointerReleased"
                                    ToolTipService.ToolTip="Start Organizing"
                                    AutomationProperties.AutomationId="HeroOrganizeButton"
                                    AutomationProperties.Name="Organize Files"
                                    Background="{ThemeResource SystemAccentColor}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    BorderThickness="0" CornerRadius="{ThemeResource ControlCornerRadiusLarge}" Padding="24,14"
                                    HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE768;" FontSize="22" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Organize Files" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedFolderPath, Mode=OneWay}"
                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Opacity="0.7" TextTrimming="CharacterEllipsis"
                                                       MaxWidth="300" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel x:Name="EmptyFolderState" Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Center"
                                        Visibility="{x:Bind ViewModel.EmptyFolderVisibility, Mode=OneWay}">
                                <FontIcon Glyph="&#xE8A5;" FontSize="14"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="No files found in this folder." Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10"
                                        Visibility="{x:Bind ViewModel.FolderSelectedVisibility, Mode=OneWay}">
                                <Button Command="{x:Bind ViewModel.UndoCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}"
                                        PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited"
                                        PointerPressed="Button_PointerPressed" PointerReleased="Button_PointerReleased"
                                        ToolTipService.ToolTip="Undo"
                                        AutomationProperties.AutomationId="StandardUndoButton"
                                        AutomationProperties.Name="Undo last operation"
                                        CornerRadius="{ThemeResource ControlCornerRadius}" Padding="14,8">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                                        <TextBlock Text="Undo" FontSize="13" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind ViewModel.RestoreAllCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}"
                                        PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited"
                                        PointerPressed="Button_PointerPressed" PointerReleased="Button_PointerReleased"
                                        ToolTipService.ToolTip="Restore All"
                                        AutomationProperties.AutomationId="StandardRestoreAllButton"
                                        AutomationProperties.Name="Restore all files"
                                        CornerRadius="{ThemeResource ControlCornerRadius}" Padding="14,8">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE777;" FontSize="14" />
                                        <TextBlock Text="Restore" FontSize="13" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                            Visibility="{x:Bind ViewModel.WorkingVisibility, Mode=OneWay}">
                                    <ProgressBar Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
                                                 IsIndeterminate="False" Width="140" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                                               VerticalAlignment="Center" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ItemsControl Visibility="{x:Bind ViewModel.FolderSelectedVisibility, Mode=OneWay}"
                                  HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <Border Style="{StaticResource StatCardStyle}">
                            <StackPanel HorizontalAlignment="Center" Spacing="2" MinWidth="64">
                                <FontIcon Glyph="&#xE722;" FontSize="22" HorizontalAlignment="Center"
                                          Foreground="{ThemeResource SystemAccentColor}" />
                                <TextBlock Text="{x:Bind ViewModel.ImageCount, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                                <TextBlock Text="Images" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCardStyle}">
                            <StackPanel HorizontalAlignment="Center" Spacing="2" MinWidth="64">
                                <FontIcon Glyph="&#xE8A5;" FontSize="22" HorizontalAlignment="Center"
                                          Foreground="{ThemeResource SystemAccentColor}" />
                                <TextBlock Text="{x:Bind ViewModel.DocumentCount, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                                <TextBlock Text="Documents" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCardStyle}">
                            <StackPanel HorizontalAlignment="Center" Spacing="2" MinWidth="64">
                                <FontIcon Glyph="&#xE714;" FontSize="22" HorizontalAlignment="Center"
                                          Foreground="{ThemeResource SystemAccentColor}" />
                                <TextBlock Text="{x:Bind ViewModel.VideoCount, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                                <TextBlock Text="Videos" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCardStyle}">
                            <StackPanel HorizontalAlignment="Center" Spacing="2" MinWidth="64">
                                <FontIcon Glyph="&#xE8D6;" FontSize="22" HorizontalAlignment="Center"
                                          Foreground="{ThemeResource SystemAccentColor}" />
                                <TextBlock Text="{x:Bind ViewModel.AudioCount, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                                <TextBlock Text="Audio" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCardStyle}">
                            <StackPanel HorizontalAlignment="Center" Spacing="2" MinWidth="64">
                                <FontIcon Glyph="&#xE773;" FontSize="22" HorizontalAlignment="Center"
                                          Foreground="{ThemeResource SystemAccentColor}" />
                                <TextBlock Text="{x:Bind ViewModel.ArchiveCount, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                                <TextBlock Text="Archives" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCardStyle}">
                            <StackPanel HorizontalAlignment="Center" Spacing="2" MinWidth="64">
                                <FontIcon Glyph="&#xE943;" FontSize="22" HorizontalAlignment="Center"
                                          Foreground="{ThemeResource SystemAccentColor}" />
                                <TextBlock Text="{x:Bind ViewModel.CodeCount, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                                <TextBlock Text="Code" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCardStyle}">
                            <StackPanel HorizontalAlignment="Center" Spacing="2" MinWidth="64">
                                <FontIcon Glyph="&#xE771;" FontSize="22" HorizontalAlignment="Center"
                                          Foreground="{ThemeResource SystemAccentColor}" />
                                <TextBlock Text="{x:Bind ViewModel.OtherCount, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                                <TextBlock Text="Other" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </ItemsControl>
                </StackPanel>

                <!-- ====== PRO MODE ====== -->
                <StackPanel x:Name="ProLayout" Visibility="{x:Bind ViewModel.ProVisibility, Mode=OneWay}" Spacing="20">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Organizer" Style="{StaticResource TitleTextBlockStyle}" />
                        <Border Grid.Column="2" Background="{ThemeResource SystemAccentColor}" CornerRadius="6" Padding="8,3">
                            <TextBlock Text="PRO" FontWeight="Bold" FontSize="11" Foreground="White" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource FluentCardStyle}" Padding="20">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button x:Name="ProSelectFolderButton" Command="{x:Bind ViewModel.PickFolderCommand}" Width="44" Height="44"
                                        PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited"
                                        PointerPressed="Button_PointerPressed" PointerReleased="Button_PointerReleased"
                                        ToolTipService.ToolTip="Select Folder"
                                        AutomationProperties.AutomationId="ProSelectFolderButton"
                                        AutomationProperties.Name="Select folder"
                                        Background="{ThemeResource SystemAccentColor}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        BorderThickness="0" CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE838;" FontSize="16" />
                                        <TextBlock Text="Select Folder" VerticalAlignment="Center" FontSize="13" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{x:Bind ViewModel.SelectedFolderPath, Mode=OneWay}"
                                           VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="OrganizeButton" Command="{x:Bind ViewModel.OrganizeCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanOrganize, Mode=OneWay}" Width="44" Height="44"
                                        PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited"
                                        PointerPressed="Button_PointerPressed" PointerReleased="Button_PointerReleased"
                                        ToolTipService.ToolTip="Organize Files"
                                        AutomationProperties.AutomationId="ProOrganizeButton"
                                        AutomationProperties.Name="Organize files"
                                        Background="{ThemeResource SystemAccentColor}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        BorderThickness="0" CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE768;" FontSize="16" />
                                        <TextBlock Text="Organize" VerticalAlignment="Center" FontSize="13" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind ViewModel.UndoCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}" Width="44" Height="44"
                                        PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited"
                                        PointerPressed="Button_PointerPressed" PointerReleased="Button_PointerReleased"
                                        ToolTipService.ToolTip="Undo"
                                        AutomationProperties.AutomationId="ProUndoButton"
                                        AutomationProperties.Name="Undo last operation"
                                        CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE7A7;" FontSize="16" />
                                        <TextBlock Text="Undo" VerticalAlignment="Center" FontSize="13" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind ViewModel.RestoreAllCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}" Width="44" Height="44"
                                        PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited"
                                        PointerPressed="Button_PointerPressed" PointerReleased="Button_PointerReleased"
                                        ToolTipService.ToolTip="Restore All"
                                        AutomationProperties.AutomationId="ProRestoreAllButton"
                                        AutomationProperties.Name="Restore all files"
                                        CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE777;" FontSize="16" />
                                        <TextBlock Text="Restore" VerticalAlignment="Center" FontSize="13" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                            Visibility="{x:Bind ViewModel.WorkingVisibility, Mode=OneWay}">
                                    <ProgressBar Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
                                                 IsIndeterminate="False" Width="130" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                                               VerticalAlignment="Center" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource FluentCardStyle}" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Statistics" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource StatCardStyle}">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE722;" FontSize="20" HorizontalAlignment="Center"
                                                  Foreground="{ThemeResource SystemAccentColor}" />
                                        <TextBlock Text="{x:Bind ViewModel.ImageCount, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Images" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource StatCardStyle}">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="20" HorizontalAlignment="Center"
                                                  Foreground="{ThemeResource SystemAccentColor}" />
                                        <TextBlock Text="{x:Bind ViewModel.DocumentCount, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Documents" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource StatCardStyle}">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE714;" FontSize="20" HorizontalAlignment="Center"
                                                  Foreground="{ThemeResource SystemAccentColor}" />
                                        <TextBlock Text="{x:Bind ViewModel.VideoCount, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Videos" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Grid.Row="0" Style="{StaticResource StatCardStyle}">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE8D6;" FontSize="20" HorizontalAlignment="Center"
                                                  Foreground="{ThemeResource SystemAccentColor}" />
                                        <TextBlock Text="{x:Bind ViewModel.AudioCount, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Audio" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource StatCardStyle}">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE773;" FontSize="20" HorizontalAlignment="Center"
                                                  Foreground="{ThemeResource SystemAccentColor}" />
                                        <TextBlock Text="{x:Bind ViewModel.ArchiveCount, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Archives" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource StatCardStyle}">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE943;" FontSize="20" HorizontalAlignment="Center"
                                                  Foreground="{ThemeResource SystemAccentColor}" />
                                        <TextBlock Text="{x:Bind ViewModel.CodeCount, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Code" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Grid.Row="1" Style="{StaticResource StatCardStyle}">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE771;" FontSize="20" HorizontalAlignment="Center"
                                                  Foreground="{ThemeResource SystemAccentColor}" />
                                        <TextBlock Text="{x:Bind ViewModel.OtherCount, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Other" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource FluentCardStyle}" Padding="20">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Control Panel" Style="{StaticResource BodyStrongTextBlockStyle}" />

                            <Border Background="{ThemeResource CardBackgroundFillColorSecondary}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="&#xE943; Custom Rules" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{x:Bind ViewModel.NewRuleExtension, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Header="Extension"
                                                 PlaceholderText=".pdf" />
                                        <TextBox Grid.Column="1"
                                                 Text="{x:Bind ViewModel.NewRuleCategoryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Header="Category"
                                                 PlaceholderText="Category name" />
                                        <Button Grid.Column="2" Command="{x:Bind ViewModel.AddCustomRuleCommand}"
                                                Content="&#xE109;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12"
                                                Width="32" Height="32" VerticalAlignment="Bottom"
                                                ToolTipService.ToolTip="Add Rule"
                                                AutomationProperties.AutomationId="AddCustomRuleButton"
                                                AutomationProperties.Name="Add custom rule" />
                                    </Grid>
                                    <ListView ItemsSource="{x:Bind ViewModel.CustomRules, Mode=OneWay}" MaxHeight="140">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:ExtensionRule">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind Extension}" FontFamily="Consolas" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind CategoryName}" />
                                                    <Button Grid.Column="2" Content="✕" FontSize="11" Width="28" Height="28"
                                                            AutomationProperties.Name="Remove rule"
                                                            Click="OnRemoveRuleClick" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBox Text="{x:Bind ViewModel.FolderNamingPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="Folder pattern: {category}, {YYYY}-{MM}_{category}, etc."
                                             Header="Folder Naming Pattern"
                                             AutomationProperties.AutomationId="FolderNamingPatternTextBox" />
                                </StackPanel>
                            </Border>

                            <Border Background="{ThemeResource CardBackgroundFillColorSecondary}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="&#xE943; Trigger Rules" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" SelectedIndex="{x:Bind ViewModel.NewTriggerTypeIndex, Mode=TwoWay}"
                                                  Header="Match"
                                                  HorizontalAlignment="Stretch">
                                            <x:String>Contains</x:String>
                                            <x:String>Starts With</x:String>
                                            <x:String>Ends With</x:String>
                                            <x:String>Regex</x:String>
                                        </ComboBox>
                                        <TextBox Grid.Column="1"
                                                 Text="{x:Bind ViewModel.NewTriggerValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Header="Trigger value"
                                                 PlaceholderText="Trigger value" />
                                        <TextBox Grid.Column="2" Width="100"
                                                 Text="{x:Bind ViewModel.NewTriggerCategoryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Header="Category"
                                                 PlaceholderText="Category" />
                                    </Grid>
                                    <Button Command="{x:Bind ViewModel.AddTriggerRuleCommand}"
                                            Content="&#xE109;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12"
                                            Width="32" Height="32" ToolTipService.ToolTip="Add Trigger Rule"
                                            HorizontalAlignment="Left"
                                            AutomationProperties.AutomationId="AddTriggerRuleButton"
                                            AutomationProperties.Name="Add trigger rule" />
                                    <ListView ItemsSource="{x:Bind ViewModel.RuleModels, Mode=OneWay}" MaxHeight="120">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:RuleModel">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind TriggerType}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind TriggerValue}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="→" HorizontalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind TargetCategory}" />
                                                    <Button Grid.Column="2" Content="✕" FontSize="11" Width="28" Height="28"
                                                            AutomationProperties.Name="Remove trigger rule"
                                                            Click="OnRemoveTriggerRuleClick" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <Border Background="{ThemeResource CardBackgroundFillColorSecondary}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="&#xE8AC; Rename Files" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{x:Bind ViewModel.RenamePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Header="Pattern"
                                                 PlaceholderText="Pattern: {name}_{n}{ext}" />
                                        <NumberBox Grid.Column="1"
                                                   Value="{x:Bind ViewModel.RenameStartNumber, Mode=TwoWay}"
                                                   Header="Start" Minimum="1" Maximum="999999"
                                                   SpinButtonPlacementMode="Compact" SmallChange="1" />
                                        <NumberBox Grid.Column="2"
                                                   Value="{x:Bind ViewModel.RenamePadding, Mode=TwoWay}"
                                                   Header="Pad" Minimum="1" Maximum="9"
                                                   SpinButtonPlacementMode="Compact" AutomationProperties.Name="Digit padding" />
                                    </Grid>
                                    <Button Command="{x:Bind ViewModel.RenameCommand}"
                                            IsEnabled="{x:Bind ViewModel.CanOrganize, Mode=OneWay}"
                                            Width="36" Height="36"
                                            ToolTipService.ToolTip="Apply Rename"
                                            AutomationProperties.AutomationId="ApplyRenameButton"
                                            AutomationProperties.Name="Apply rename">
                                        <TextBlock Text="&#xE8AC;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource FluentCardStyle}" Padding="20">
                        <StackPanel Spacing="8">
                            <Grid Visibility="{x:Bind ViewModel.FolderSelectedVisibility, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Files" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{x:Bind ViewModel.SortModes}"
                                          SelectedItem="{x:Bind ViewModel.SortMode, Mode=TwoWay}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Width="140" Margin="0,0,8,0"
                                          AutomationProperties.AutomationId="FilesSortComboBox" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Command="{x:Bind ViewModel.SetListViewCommand}" Content="&#xE992;"
                                            PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited"
                                            PointerPressed="Button_PointerPressed" PointerReleased="Button_PointerReleased"
                                            Width="32" Height="32"
                                            AutomationProperties.AutomationId="ListViewToggleButton"
                                            AutomationProperties.Name="List view" />
                                    <Button Command="{x:Bind ViewModel.SetGridViewCommand}" Content="&#xE8A9;"
                                            PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited"
                                            PointerPressed="Button_PointerPressed" PointerReleased="Button_PointerReleased"
                                            Width="32" Height="32"
                                            AutomationProperties.AutomationId="GridViewToggleButton"
                                            AutomationProperties.Name="Grid view" />
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="ProEmptyFolderState" Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Center" Margin="0,12"
                                        Visibility="{x:Bind ViewModel.EmptyFolderVisibility, Mode=OneWay}">
                                <FontIcon Glyph="&#xE8A5;" FontSize="14"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="No files found in this folder." Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <ListView x:Name="FileListView"
                                      ItemsSource="{x:Bind ViewModel.Files, Mode=OneWay}"
                                      MaxHeight="360"
                                      x:Load="{x:Bind ViewModel.IsListView, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.FolderSelectedVisibility, Mode=OneWay}">
                                <ListView.Header>
                                    <Grid Padding="12,4" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Name" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="Category" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="Modified" FontWeight="SemiBold" />
                                    </Grid>
                                </ListView.Header>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:FileEntry">
                                        <Grid Padding="12,4" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Category}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind DateModified}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <GridView x:Name="FileGridView"
                                      ItemsSource="{x:Bind ViewModel.Files, Mode=OneWay}"
                                      MaxHeight="360" SelectionMode="None"
                                      x:Load="{x:Bind ViewModel.IsGridView, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.FolderSelectedVisibility, Mode=OneWay}">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="models:FileEntry">
                                        <Border Width="110" Height="110" CornerRadius="10"
                                                Background="{ThemeResource CardBackgroundFillColorDefault}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefault}" BorderThickness="1" Padding="6">
                                            <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE8A5;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                           FontSize="28" HorizontalAlignment="Center" Foreground="{ThemeResource SystemAccentColor}" />
                                                <TextBlock Text="{x:Bind Name}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                           TextWrapping="Wrap" MaxLines="2" HorizontalAlignment="Center" TextAlignment="Center" />
                                                <TextBlock Text="{x:Bind Category}" FontSize="10"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Visibility="{x:Bind ViewModel.WorkingVisibility, Mode=OneWay}"
              Background="{ThemeResource ScrimFillBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{ThemeResource CardBackgroundFillColorDefault}" CornerRadius="14" Padding="28,20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14" HorizontalAlignment="Center" MinWidth="260">
                    <ProgressRing IsActive="True" Width="44" Height="44" HorizontalAlignment="Center" />
                    <ProgressBar Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" IsIndeterminate="False" Width="220" />
                    <TextBlock Text="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" HorizontalAlignment="Center" FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Command="{x:Bind ViewModel.CancelOperationCommand}"
                            Content="&#xE10A;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            HorizontalAlignment="Center" Width="36" Height="36"
                            AutomationProperties.AutomationId="CancelOperationButton"
                            AutomationProperties.Name="Cancel operation"
                            ToolTipService.ToolTip="Cancel" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== TEACHING TIPS ===== -->
        <TeachingTip x:Name="StandardSelectFolderTip"
                     Target="{x:Bind StandardSelectFolderButton}"
                     Title="Select a Folder"
                     Subtitle="Pick any folder on your PC and FluentFold will categorize its files into Images, Documents, Videos, and more."
                     PreferredPlacement="Bottom"
                     IsLightDismissEnabled="True" />
        <TeachingTip x:Name="HeroOrganizeTip"
                     Target="{x:Bind HeroOrganizeButton}"
                     Title="Organize Files"
                     Subtitle="This will sort all files into categorized folders with one click. You can undo anytime."
                     PreferredPlacement="Bottom"
                     IsLightDismissEnabled="True" />
        <TeachingTip x:Name="ProSelectFolderTip"
                     Target="{x:Bind ProSelectFolderButton}"
                     Title="Select a Folder"
                     Subtitle="Pick any folder to analyze and organize. Pro mode gives you custom rules and renaming."
                     PreferredPlacement="Bottom"
                     IsLightDismissEnabled="True" />
        <TeachingTip x:Name="ProOrganizeTip"
                     Target="{x:Bind OrganizeButton}"
                     Title="Organize Files"
                     Subtitle="Sorts files into categorized folders. You can customize rules in the Control Panel below."
                     PreferredPlacement="Bottom"
                     IsLightDismissEnabled="True" />
    </Grid>
</Page>
