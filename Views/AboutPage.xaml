<Page
    x:Class="FluentFold.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" Padding="24">
        <ScrollViewer>
            <StackPanel Spacing="24" HorizontalAlignment="Center" MaxWidth="600">

                <TextBlock Text="About FluentFold" Style="{StaticResource TitleTextBlockStyle}" />

                <!-- Card 0: What's New -->
                <Border Style="{StaticResource SettingsCardStyle}" Padding="24">
                    <StackPanel Spacing="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE8F1;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                       FontSize="22" Foreground="{ThemeResource SystemAccentColor}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="What's New" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="A recap of the latest changes in this release."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Border Grid.Column="2" Background="{ThemeResource SystemAccentColor}"
                                    CornerRadius="{ThemeResource ControlCornerRadius}" Padding="10,4"
                                    VerticalAlignment="Center">
                                <TextBlock Text="1.1.0-beta" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                        </Grid>

                        <Border Background="{ThemeResource CardBackgroundFillColorSecondary}"
                                CornerRadius="{ThemeResource ControlCornerRadius}" Padding="16,4">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Organizer" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemAccentColor}" Margin="0,6,0,0" />
                                <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="20">
                                    <Run Text="&#xE73E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />  Redesigned the Organizer screen with a new hero layout, stat cards, and empty states.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="20">
                                    <Run Text="&#xE73E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />  Added guided teaching tips for first-time users, dismissible with light dismiss.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="20">
                                    <Run Text="&#xE73E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />  Folder picker now uses a stable window handle so the picker opens every time.
                                </TextBlock>

                                <TextBlock Text="Analyzer" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemAccentColor}" Margin="0,6,0,0" />
                                <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="20">
                                    <Run Text="&#xE73E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />  Progress is now real — no more fake percentage cap — with elapsed and estimated time remaining.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="20">
                                    <Run Text="&#xE73E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />  Results split into independent cards for Temporary, Cache, and Duplicate files.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="20">
                                    <Run Text="&#xE73E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />  Select All available in every category card; scanning no longer freezes the app.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="20">
                                    <Run Text="&#xE73E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />  Scan progress now surfaces fine-grained updates, including the duplicate-hashing phase.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="20">
                                    <Run Text="&#xE73E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />  Cleaner scanning card: replaced the progress bar with a single loading indicator.
                                </TextBlock>

                                <TextBlock Text="General" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemAccentColor}" Margin="0,6,0,0" />
                                <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="20">
                                    <Run Text="&#xE73E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />  Full Fluent design pass: light/dark/high-contrast tokens, accent contrast, and larger corner radii.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="20">
                                    <Run Text="&#xE73E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />  Accessibility improvements: automation names and IDs on all interactive controls.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="20">
                                    <Run Text="&#xE73E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />  Brand-new app logo across the store listing, Start menu, and splash screen.
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Card 1: The Story -->
                <Border Style="{StaticResource SettingsCardStyle}" Padding="24">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Our Mission" FontWeight="SemiBold" FontSize="18" />
                        <TextBlock TextWrapping="Wrap" FontSize="14"
                                   LineHeight="22"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            FluentFold was born out of a personal need for order in a digital world.
                            I built this app because I needed it, and I know you do too.
                            My goal is to simplify your workflow and reclaim your time.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Card 2: Developer -->
                <Border Style="{StaticResource SettingsCardStyle}" Padding="24">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Connect" FontWeight="SemiBold" FontSize="18" />
                        <HyperlinkButton Click="OnGitHubClick" Padding="0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image Source="/Assets/GitHubLogo.svg" Width="18" Height="18" Stretch="Uniform" />
                                <TextBlock Text="GitHub" VerticalAlignment="Center"
                                           FontSize="14"
                                           Foreground="{ThemeResource SystemAccentColor}" />
                            </StackPanel>
                        </HyperlinkButton>
                        <HyperlinkButton Click="OnFeedbackClick" Padding="0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          Glyph="&#xED1E;"
                                          FontSize="18"
                                          Foreground="{ThemeResource SystemAccentColor}" />
                                <TextBlock Text="Feedback" VerticalAlignment="Center"
                                           FontSize="14"
                                           Foreground="{ThemeResource SystemAccentColor}" />
                            </StackPanel>
                        </HyperlinkButton>
                    </StackPanel>
                </Border>

                <!-- Card 3: Value Proposition -->
                <Border Style="{StaticResource SettingsCardStyle}" Padding="24">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Why FluentFold?" FontWeight="SemiBold" FontSize="18" />
                        <TextBlock TextWrapping="Wrap" FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                            Make your life easier by organizing your files.
                            Reclaim your digital space, one folder at a time.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Version -->
                <TextBlock x:Name="VersionText"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center"
                           FontSize="12" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
