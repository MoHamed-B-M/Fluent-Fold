<Project>
  <PropertyGroup>
    <_WinAppAnalyzerDir Condition="Exists('$(MSBuildThisFileDirectory).opencode\skills\winui-dev-workflow\analyzer')">$(MSBuildThisFileDirectory).opencode\skills\winui-dev-workflow\analyzer</_WinAppAnalyzerDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(_WinAppAnalyzerDir)' != ''">
    <Analyzer Include="$(_WinAppAnalyzerDir)\Microsoft.WindowsAppSDK.Analyzers.dll" />
  </ItemGroup>
  <Import Project="$(_WinAppAnalyzerDir)\Microsoft.WindowsAppSDK.Analyzers.targets" Condition="'$(_WinAppAnalyzerDir)' != ''" />
</Project>